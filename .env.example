WEB_PORT=8080
APP_ENV=development
APP_DATA_DIR=./data
APP_DB_URL=sqlite:///./data/app.sqlite3
APP_TIMEZONE=Asia/Shanghai
API_BIND=0.0.0.0:8000
# 本地开发可由 `python -m app.cli init --with-password` 生成；生产请挂载受限 Secret 文件。
APP_MASTER_KEY_FILE=./data/master.key
APP_BOOTSTRAP_PASSWORD_FILE=./data/bootstrap_password
# 生产也可以使用 APP_MASTER_KEY=<32 字节原始值或 Base64>，不要提交真实值。
# APP_MASTER_KEY=
APP_SESSION_TTL_SECONDS=86400
APP_ALLOWED_ORIGIN=http://localhost:8080,http://localhost:5173
CAPTURE_DEFAULT_INTERVAL_MS=1000
WORKER_CONCURRENCY=2
LOG_LEVEL=INFO
# 生产环境请显式设置；不要把真实密钥提交到仓库。
APP_PROVIDER_ALLOWED_HOSTS=
APP_RTSP_ALLOWED_HOSTS=

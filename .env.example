# 本机开发配置；复制为根目录 .env 后由 start-local.ps1 加载。
# 正式部署不启用 CAW_LOCAL_DEV，必须使用 HTTPS。
CAW_LOCAL_DEV=1
CAW_ALLOWED_ORIGIN=http://127.0.0.1:5173
CAW_DATA_DIR=data/local
# 主密钥默认自动创建在用户数据目录（仓库外），无需填写。
# CAW_MASTER_KEY_FILE=C:/Users/YOUR_NAME/AppData/Local/Camera-AI-Workbench/master.key
CAW_RTSP_ALLOWED_HOSTS=127.0.0.1
CAW_RTSP_ALLOWED_PORTS=15554,15555
CAW_FFMPEG=ffmpeg
CAW_PROVIDER_ALLOWED_HOSTS=
CAW_PROVIDER_LOCAL_ENDPOINTS=

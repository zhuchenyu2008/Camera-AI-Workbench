{
  "name": "camera-ai-workbench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:help": "node scripts/build-help.mjs",
    "dev": "npm run build:help && vite --host 127.0.0.1",
    "generate": "node scripts/generate-api.mjs",
    "check:contracts": "node scripts/generate-api.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:help && npm run check:contracts && tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.16",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^27.4.0",
    "markdown-it": "^15.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
